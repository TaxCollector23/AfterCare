# Copy this file to .env.local (gitignored) and fill in your real values.
# Never commit real keys — .env.local stays out of git via the repo .gitignore.

# --- Firebase (Project settings -> General -> Your apps -> SDK setup and configuration) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google Drive connector (Google Cloud Console -> APIs & Services -> Credentials) ---
# OAuth 2.0 Client ID (Web application type) — used for Drive file picking/import.
VITE_GOOGLE_DRIVE_CLIENT_ID=
# API key restricted to the Google Picker API + Drive API.
VITE_GOOGLE_DRIVE_API_KEY=

# --- Optional: backend API base URL (apps/api), once that service exists ---
# Leave blank to run in Firebase-only mode (no backend calls are made).
VITE_API_BASE_URL=

# --- Read-aloud voice (optional). Priority: ElevenLabs > Google Cloud TTS > browser voice. ---
# Leave both blank to use the browser's built-in speech synthesis (no key needed).
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=
VITE_GOOGLE_TTS_API_KEY=
