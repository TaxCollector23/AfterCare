# apps/web — BROWSER environment variables.
#
# WARNING: everything with a VITE_ prefix is compiled into the JavaScript bundle
# and is therefore PUBLIC. Never put a secret here — no OpenAI key, no Gemini key,
# no database URL. Those belong to apps/api (see apps/api/.env.example) and must be
# set on the SERVER, not in this file.
#
# All of these are optional. With none of them set, AfterCare runs in local mode:
# the whole site loads and documents are saved in your own browser.

# --- AfterCare API (apps/api) ---------------------------------------------
# Where the backend lives. Defaults to same-origin "/api" when unset.
# The app probes <base>/health on load; if it doesn't answer, it silently falls
# back to Firebase (if configured) and then to local mode.
VITE_API_BASE_URL=

# --- Firebase (optional) ---------------------------------------------------
# Project settings -> General -> Your apps -> SDK setup and configuration.
# Firebase web config values are meant to be public; access is controlled by the
# security rules in /firestore.rules and /storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google Drive picker (optional) ----------------------------------------
# Google Cloud Console -> APIs & Services. Enable the Picker API and Drive API.
# The "Connect from Google Drive" button only appears when both are set.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=

# --- Read-aloud voice (optional) -------------------------------------------
# Leave blank to use the browser's built-in voice, which needs no key.
# Priority: ElevenLabs > Google Cloud TTS > browser.
# These are called directly from the browser, so the key is visible to anyone
# using the site. Restrict them by HTTP referrer, or proxy them through apps/api.
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=
VITE_GOOGLE_TTS_API_KEY=
