NODE_ENV=development
PORT=3001
API_RATE_LIMIT=500
UPLOAD_RATE_LIMIT=100
MOCK_INTEGRATIONS=true
WEB_ORIGIN=https://your-pwa.example
DATABASE_URL=
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
# Generate a base64 key with: openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
AWS_REGION=us-west-2
S3_BUCKET=
# Google OAuth client, used for two separate things:
#   1. Sign in with Google (POST /auth/google) — the primary sign-in. Only
#      GOOGLE_CLIENT_ID is needed for this, and it must match the browser's
#      VITE_GOOGLE_CLIENT_ID, since the ID token's audience is checked against
#      it. Without it, /auth/google returns 503 and the app falls back to
#      email and password.
#   2. Google Drive import, which additionally needs the secret, redirect URI,
#      and state secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api.example/drive/callback
GOOGLE_STATE_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_FALLBACK=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
JUDGE_MODEL=
AI_TIMEOUT_MS=45000
REDIS_URL=
PDF_OCR_RASTER_SCALE=2
PDF_OCR_VISION_CONCURRENCY=3
