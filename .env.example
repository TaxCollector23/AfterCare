# AI provider waterfall (server-side only; never expose these as VITE_* values)
# Order: OpenAI -> OpenRouter -> Gemini primary -> Gemini fallback.
# Free-tier-friendly: OpenRouter `:free` models and Gemini Flash need no paid quota.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_FALLBACK=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
# Dedicated judge model for the verification stage (optional; defaults to the main text model)
JUDGE_MODEL=

# Per-provider LLM request timeout in milliseconds (default 45000)
AI_TIMEOUT_MS=45000

# Optional cache and OCR tuning
REDIS_URL=
PDF_OCR_RASTER_SCALE=2
PDF_OCR_VISION_CONCURRENCY=3
