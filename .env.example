# LLM Provider API Keys
# Add these to your Vercel environment variables for production

# OpenAI
OPENAI_API_KEY=sk_test_placeholder_openai_key_1234567890

# Google AI Studio (Gemini)
GEMINI_API_KEY=AIzaSy_test_placeholder_gemini_key_1
GEMINI_API_KEY_2=AIzaSy_test_placeholder_gemini_key_2
GEMINI_API_KEY_3=AIzaSy_test_placeholder_gemini_key_3

# OpenRouter
OPENROUTER_API_KEY=sk_test_placeholder_openrouter_key_1
OPENROUTER_API_KEY_2=sk_test_placeholder_openrouter_key_2

# Anthropic (optional)
ANTHROPIC_API_KEY=sk_test_placeholder_anthropic_key_1
ANTHROPIC_API_KEY_2=sk_test_placeholder_anthropic_key_2

# Cache & Storage
REDIS_URL=redis://localhost:6379

# Models (optional overrides)
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# OCR Settings
PDF_OCR_RASTER_SCALE=2
PDF_OCR_VISION_CONCURRENCY=3
