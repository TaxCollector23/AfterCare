# AI provider waterfall (server-side only; never expose these as VITE_* values)
OPENAI_API_KEY=
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_FALLBACK=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# Optional cache and OCR tuning
REDIS_URL=
PDF_OCR_RASTER_SCALE=2
PDF_OCR_VISION_CONCURRENCY=3
