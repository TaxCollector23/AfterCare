rules_version = '2';

// Data model:
//   users/{uid}                              -> profile + caregiverEmails (array of emails granted read access)
//   users/{uid}/documents/{docId}             -> one uploaded discharge document + its processing status
//   users/{uid}/documents/{docId}/recovery/current -> the structured guide derived from that document
//
// Access model:
//   - The owner (auth.uid == uid) has full read/write access to everything under their own users/{uid}.
//   - A caregiver (their auth token's email appears in users/{uid}.caregiverEmails) gets read-only
//     access to the same tree. Caregivers can never write, and can never add themselves — only the
//     owner can grant access (see addCaregiverEmail in src/services/firestore.ts).
//
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Note: Firestore rules have no string-lowercasing function, so this compares the
    // caregiver's Firebase Auth email as-is against the (already-lowercased-on-write)
    // caregiverEmails list. Caregivers should sign up using all-lowercase email addresses.
    function isCaregiver(uid) {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.auth.token.email in
           get(/databases/$(database)/documents/users/$(uid)).data.get('caregiverEmails', []);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isCaregiver(uid);
      // Only the owner may create/update their own profile (including caregiverEmails).
      allow write: if isOwner(uid);

      match /documents/{docId} {
        allow read: if isOwner(uid) || isCaregiver(uid);
        allow create: if isOwner(uid) && request.resource.data.ownerUid == uid;
        allow update, delete: if isOwner(uid);

        match /recovery/{recoveryDocId} {
          allow read: if isOwner(uid) || isCaregiver(uid);
          // Recovery data is written by the processing pipeline (a trusted server context /
          // Cloud Function using the Admin SDK, which bypasses these rules entirely). Direct
          // client writes are disallowed so a patient's guide can't be tampered with client-side.
          allow write: if false;
        }
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
