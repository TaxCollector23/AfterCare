{
  "name": "discharge-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "workspaces": [
    "apps/api",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "pnpm --filter @discharge/api dev",
    "build": "pnpm --filter @discharge/api... build",
    "format": "prettier --write \"apps/api/**/*.{ts,json}\" \"packages/shared-types/**/*.{ts,json}\" \"docs/**/*.{md,yaml}\" \"*.{json,yaml}\"",
    "format:check": "prettier --check \"apps/api/**/*.{ts,json}\" \"packages/shared-types/**/*.{ts,json}\" \"docs/**/*.{md,yaml}\" \"*.{json,yaml}\"",
    "lint": "eslint apps/api/src packages/shared-types/src",
    "test": "pnpm --filter @discharge/shared-types build && pnpm --filter @discharge/api test",
    "typecheck": "pnpm --filter @discharge/api... typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.0"
  }
}
