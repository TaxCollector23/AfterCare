{
  "name": "dischargeguide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "workspaces": [
    "apps/api",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"apps/api/**/*.{ts,json}\" \"packages/shared-types/**/*.{ts,json}\" \"docs/**/*.{md,yaml}\" \"*.{json,yaml}\"",
    "format:check": "prettier --check \"apps/api/**/*.{ts,json}\" \"packages/shared-types/**/*.{ts,json}\" \"docs/**/*.{md,yaml}\" \"*.{json,yaml}\"",
    "test": "pnpm --filter @discharge/shared-types build && pnpm --filter @discharge/api test",
    "typecheck": "tsc --noEmit && pnpm --filter @discharge/api... typecheck",
    "api:dev": "pnpm --filter @discharge/api dev",
    "api:build": "pnpm --filter @discharge/api... build",
    "build:all": "next build && pnpm api:build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.39.0"
  }
}
